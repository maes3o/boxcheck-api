# Copy to .env (systemd EnvironmentFile) and fill in on the server. Never commit real values.

# Telegram transport shared by /api/feedback, /fix-request and server-error alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Best-effort duplicate of feedback into a Google Sheets log (optional)
GOOGLE_SHEETS_WEBHOOK_URL=

# "Виправте за мене" payment details, shown on /fix after a request is sent
# (served by GET /fix-request/config; not a secret, but not hardcoded either).
# Card number as a plain string, e.g. "0000 0000 0000 0000" — put the real one
# in the server's .env yourself.
FIX_SERVICE_CARD_NUMBER=
# Optional: recipient name as the bank shows it
FIX_SERVICE_CARD_NAME=
